<Window x:Class="DIPlayer.MiniPlayer" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:DIPlayer.UI"
 Title="DIPlayer mini" Width="400" Height="58" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True" Background="#101010" Foreground="#EEEEEE" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" MouseLeftButtonDown="MiniPointerDown" IsVisibleChanged="MiniVisibilityChanged">
 <Border BorderBrush="#303030" BorderThickness="1" CornerRadius="10" Padding="9,7"><Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/><ColumnDefinition Width="28"/><ColumnDefinition Width="30"/><ColumnDefinition Width="36"/><ColumnDefinition Width="30"/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions>
  <Border Background="#242424" Width="36" Height="36" VerticalAlignment="Center" CornerRadius="5" ui:RoundedClip.Radius="5"><ui:Artwork x:Name="Cover" Width="36" Height="36"/></Border>
  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="7,0,10,0" ToolTip="Double-click to open DIPlayer"><TextBlock x:Name="TrackTitle" Text="DIPlayer" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="TrackArtist" Text="Choose a track" FontSize="11" Foreground="#999999" TextTrimming="CharacterEllipsis"/></StackPanel>
  <Button x:Name="RestoreButton" Grid.Column="2" Width="26" Height="30" Padding="0" Margin="0" Background="Transparent" FontFamily="{x:Static ui:Symbols.Font}" FontWeight="Normal" Content="{x:Static ui:Symbols.Down}" FontSize="15" ToolTip="Open full player" AutomationProperties.Name="Open full player" Click="RestoreClick"/>
  <Button x:Name="PreviousButton" Grid.Column="3" Content="{x:Static ui:Symbols.Previous}" FontFamily="{x:Static ui:Symbols.Font}" FontWeight="Normal" Padding="0" Margin="0" Background="Transparent" ToolTip="Previous" AutomationProperties.Name="Previous track" Click="PreviousClick"/>
  <Button x:Name="ToggleButton" FocusVisualStyle="{x:Null}" Grid.Column="4" Content="{x:Static ui:Symbols.Play}" Margin="3,0" Padding="0" Width="30" Height="30" FontFamily="{x:Static ui:Symbols.Font}" FontWeight="Normal" Background="#EEEEEE" Foreground="#101010" ToolTip="Play / pause" AutomationProperties.Name="Play / pause" Click="ToggleClick"><Button.Template><ControlTemplate TargetType="Button"><Grid><Ellipse Fill="{TemplateBinding Background}"/><TextBlock Text="{TemplateBinding Content}" FontFamily="{x:Static ui:Symbols.Font}" FontWeight="Normal" FontSize="13" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></ControlTemplate></Button.Template></Button>
  <Button x:Name="NextButton" Grid.Column="5" Content="{x:Static ui:Symbols.Next}" FontFamily="{x:Static ui:Symbols.Font}" FontWeight="Normal" Padding="0" Margin="0" Background="Transparent" ToolTip="Next" AutomationProperties.Name="Next track" Click="NextClick"/>
  <Button x:Name="HideButton" Grid.Column="6" Width="22" Height="30" VerticalAlignment="Center" Padding="0" Margin="0" Background="Transparent" Foreground="#888888" FontFamily="{x:Static ui:Symbols.Font}" FontWeight="Normal" Content="{x:Static ui:Symbols.Close}" FontSize="13" ToolTip="Hide mini player" AutomationProperties.Name="Hide mini player" Click="HideClick"/>
 </Grid></Border>
</Window>
