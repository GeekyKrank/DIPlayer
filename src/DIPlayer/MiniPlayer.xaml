<Window x:Class="DIPlayer.MiniPlayer" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:DIPlayer.UI"
 Title="DIPlayer mini" Width="400" Height="58" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True" Background="#101010" Foreground="#EEEEEE" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" MouseLeftButtonDown="MiniPointerDown" IsVisibleChanged="MiniVisibilityChanged">
 <Border BorderBrush="#303030" BorderThickness="1" CornerRadius="10" Padding="9,7"><Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/><ColumnDefinition Width="30"/><ColumnDefinition Width="36"/><ColumnDefinition Width="30"/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions>
  <Border Background="#242424" Width="36" Height="36" VerticalAlignment="Center"><ui:Artwork x:Name="Cover" Width="36" Height="36"/></Border>
  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="7,0,10,0" ToolTip="Double-click to open DIPlayer"><TextBlock x:Name="TrackTitle" Text="DIPlayer" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="TrackArtist" Text="Choose a track" FontSize="11" Foreground="#999999" TextTrimming="CharacterEllipsis"/></StackPanel>
  <Button x:Name="PreviousButton" Grid.Column="2" Content="&#xE892;" FontFamily="Segoe MDL2 Assets" Padding="0" Margin="0" Background="Transparent" ToolTip="Previous" AutomationProperties.Name="Previous track" Click="PreviousClick"/>
  <Button x:Name="ToggleButton" FocusVisualStyle="{x:Null}" Grid.Column="3" Content="&#xE768;" Margin="3,0" Padding="0" Width="30" Height="30" FontFamily="Segoe MDL2 Assets" Background="#EEEEEE" Foreground="#101010" ToolTip="Play / pause" AutomationProperties.Name="Play / pause" Click="ToggleClick"><Button.Template><ControlTemplate TargetType="Button"><Grid><Ellipse Fill="{TemplateBinding Background}"/><TextBlock Text="{TemplateBinding Content}" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></ControlTemplate></Button.Template></Button>
  <Button x:Name="NextButton" Grid.Column="4" Content="&#xE893;" FontFamily="Segoe MDL2 Assets" Padding="0" Margin="0" Background="Transparent" ToolTip="Next" AutomationProperties.Name="Next track" Click="NextClick"/>
  <Button x:Name="HideButton" Grid.Column="5" Width="22" Height="30" VerticalAlignment="Center" Padding="0" Margin="0" Background="Transparent" Foreground="#888888" ToolTip="Hide mini player" AutomationProperties.Name="Hide mini player" Click="HideClick"><Path Data="M 1,1 L 9,9 M 9,1 L 1,9" Width="10" Height="10" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Button>
 </Grid></Border>
</Window>
