<Window x:Class="DIPlayer.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="clr-namespace:DIPlayer.UI" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="DIPlayer" Icon="Assets/diplayer.ico" Background="#080808" Foreground="#F4F4F4" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
 Width="1200" Height="780" MinWidth="440" MinHeight="560" WindowStyle="None" ResizeMode="CanResize"
 Closing="WindowClosing" StateChanged="WindowStateChanged" IsVisibleChanged="VisiblePropertyChanged"
 SourceInitialized="SourceReady" SizeChanged="LayoutChanged">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="24" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <Style x:Key="SeekSlider" TargetType="Slider">
   <Setter Property="MinHeight" Value="30"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Background="Transparent">
    <Border Height="5" CornerRadius="2.5" Background="#454545" Margin="9,0" VerticalAlignment="Center"/>
    <Track x:Name="PART_Track">
     <Track.DecreaseRepeatButton><RepeatButton Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Grid Background="Transparent"><Border Height="5" CornerRadius="2.5" Background="#DDDDDD" VerticalAlignment="Center"/></Grid></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
     <Track.Thumb><Thumb Width="18" Height="30"><Thumb.Template><ControlTemplate TargetType="Thumb"><Grid Background="Transparent"><Ellipse Width="14" Height="14" Fill="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
     <Track.IncreaseRepeatButton><RepeatButton Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
    </Track>
   </Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="TrackContextMenu" TargetType="ContextMenu">
   <Setter Property="Background" Value="#202020"/><Setter Property="Foreground" Value="#EEEEEE"/><Setter Property="BorderBrush" Value="#404040"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="4"/>
   <Setter Property="HasDropShadow" Value="False"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/></Border></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="TrackContextMenuItem" TargetType="MenuItem">
   <Setter Property="Foreground" Value="#EEEEEE"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="12,8"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#383838"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#777777"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="CompactServiceSwitch" TargetType="ToggleButton"><Setter Property="Width" Value="36"/><Setter Property="Height" Value="20"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Grid><Border x:Name="Track" Background="#444444" CornerRadius="10"/><Ellipse x:Name="Thumb" Fill="White" Width="14" Height="14" HorizontalAlignment="Left" Margin="3"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#A43A3A"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="White"/><Setter TargetName="Track" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <DataTemplate x:Key="PlaylistCover"><Border Background="#252525" CornerRadius="8" ClipToBounds="True"><Grid>
   <TextBlock Text="♫" FontSize="48" Foreground="#777777" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Cover1}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
   <Border Background="#252525"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding SingleCover}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><ui:Artwork Url="{Binding SingleCover}" DecodeWidth="256" Width="Auto" Height="Auto"/></Border>
   <Border Background="#252525"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding CustomCover}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><Image Source="{Binding CustomCover}" Stretch="UniformToFill"/></Border>
  </Grid></Border></DataTemplate>
  <Style x:Key="RailButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Width" Value="46"/><Setter Property="Height" Value="44"/><Setter Property="Padding" Value="0"/>
   <Setter Property="Margin" Value="0,3"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#8A8A8A"/>
   <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="20"/>
   <Style.Triggers><Trigger Property="Tag" Value="active"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#181818"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="Transparent"/><Setter Property="Width" Value="34"/><Setter Property="Height" Value="32"/>
   <Setter Property="Padding" Value="0"/><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="15"/>
  </Style>
  <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
   <Setter Property="Width" Value="36"/><Setter Property="Height" Value="26"/><Setter Property="Margin" Value="0"/>
   <Setter Property="FontSize" Value="10"/><Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
  </Style>
  <Style x:Key="VolumeControl" TargetType="Slider">
   <Setter Property="MinHeight" Value="28"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Background="Transparent">
    <Border Background="#454545" Height="4" Margin="7,0" CornerRadius="2" VerticalAlignment="Center"/>
    <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
     <Track.DecreaseRepeatButton><RepeatButton Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Grid Background="Transparent"><Border Background="#DADADA" Height="4" CornerRadius="2" VerticalAlignment="Center"/></Grid></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
     <Track.Thumb><Thumb Width="14" Height="28"><Thumb.Template><ControlTemplate TargetType="Thumb"><Grid Background="Transparent"><Ellipse Width="10" Height="10" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
     <Track.IncreaseRepeatButton><RepeatButton Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
    </Track>
   </Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
<ItemsPanelTemplate x:Key="PlaylistCardPanel"><WrapPanel/></ItemsPanelTemplate><Style x:Key="PlaylistCardItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Width" Value="192"/><Setter Property="Margin" Value="0,0,16,16"/><Setter Property="Padding" Value="4"/><Setter Property="Cursor" Value="Hand"/></Style><DataTemplate x:Key="PlaylistCardTemplate"><StackPanel><ContentControl Content="{Binding}" ContentTemplate="{StaticResource PlaylistCover}" Width="184" Height="184"/><TextBlock Text="{Binding Name}" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,10,0,4"/><TextBlock Text="{Binding CountLabel}" Foreground="#999999"/></StackPanel></DataTemplate>
<ItemsPanelTemplate x:Key="PlaylistTablePanel"><StackPanel/></ItemsPanelTemplate>
<Style x:Key="PlaylistTableItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,4"/><Setter Property="Padding" Value="8"/><Setter Property="Cursor" Value="Hand"/></Style>
<DataTemplate x:Key="PlaylistTableTemplate"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition/><ColumnDefinition Width="65"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><ContentControl Content="{Binding}" ContentTemplate="{StaticResource PlaylistCover}" Width="36" Height="36"/><TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="8,0" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding Count}" Foreground="#AAAAAA" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="{Binding StatusLabel}" Foreground="#999999" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid></DataTemplate>
 </Window.Resources>
 <Border x:Name="WindowFrame" CornerRadius="24" BorderBrush="#202020" BorderThickness="1"><Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Grid Grid.Column="1">
   <Border IsHitTestVisible="False"><Border.Background><ImageBrush Stretch="UniformToFill" AlignmentX="Right"><ImageBrush.ImageSource><BitmapImage UriSource="Assets/wallpaper.jpg" DecodePixelWidth="736" CacheOption="OnLoad"/></ImageBrush.ImageSource></ImageBrush></Border.Background></Border>
   <Border Background="#64000000" IsHitTestVisible="False"/>
   <Border IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#90000000" Offset="0"/><GradientStop Color="#08000000" Offset="0.8"/></LinearGradientBrush></Border.Background></Border>
   <Border IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0.55"/><GradientStop Color="#FF000000" Offset="0.88"/></LinearGradientBrush></Border.Background></Border>
  </Grid>
  <!-- Static background; no blur, animation or transparent top-level window. -->
  <Border Background="#080808" BorderBrush="#141414" BorderThickness="0,0,1,0"><Grid><StackPanel Margin="8,10">
    <Button Background="Transparent" Width="62" Height="68" Padding="0" Margin="-8,-8,-8,7" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Home" Click="HomeView"><Image Width="46" Height="58" Stretch="Uniform"><Image.Source><BitmapImage UriSource="Assets/bulldog-logo.png" DecodePixelHeight="128" CacheOption="OnLoad"/></Image.Source></Image></Button>
    <Button x:Name="HomeNav" Tag="active" Style="{StaticResource RailButton}" Content="&#xE80F;" ToolTip="Library · Home" AutomationProperties.Name="Library" Click="HomeView"/>
    <StackPanel x:Name="SoundCloudRail">
    <Button x:Name="SearchNav" Style="{StaticResource RailButton}" Content="&#xE721;" ToolTip="Search" AutomationProperties.Name="Search" Click="SearchView"/>
    <Button x:Name="QueueNav" Style="{StaticResource RailButton}" Content="&#xE142;" ToolTip="Queue" AutomationProperties.Name="Queue" Click="QueueView"/>
    <Button x:Name="ImportNav" Style="{StaticResource RailButton}" Content="&#xE896;" ToolTip="Import a public playlist by URL" AutomationProperties.Name="Import by URL" Click="ImportClick"/>
    </StackPanel>
    <StackPanel x:Name="YouTubeRail" Visibility="Collapsed">
     <Button x:Name="YouTubeLibraryNav" Style="{StaticResource RailButton}" Content="&#xE8F1;" ToolTip="YouTube Music library" AutomationProperties.Name="YouTube Music library" Click="YouTubeLibraryClick"/>
     <Button x:Name="YouTubeLikesNav" Style="{StaticResource RailButton}" Content="&#xEB51;" ToolTip="YouTube Music likes" AutomationProperties.Name="YouTube Music likes" Click="YouTubeLikesClick"/>
    </StackPanel>
  </StackPanel><Button x:Name="SettingsNav" Style="{StaticResource RailButton}" Content="&#xE713;" ToolTip="Settings" AutomationProperties.Name="Settings" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,12" Click="OpenPlayerSettings"/></Grid></Border>
  <Grid Grid.Column="1">
   <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition x:Name="PlayerRow" Height="100"/></Grid.RowDefinitions>
   <Grid Margin="15,0,12,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Grid HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock x:Name="BrandTitle" Text="DIPlayer" FontWeight="Normal" FontSize="14" LineHeight="22" LineStackingStrategy="BlockLineHeight" Foreground="#EEEEEE" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"/><Image x:Name="BrandLogo" Visibility="Collapsed" Height="22" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" AutomationProperties.Name="DIPlayer"/></Grid>
    <StackPanel Grid.Column="1" Margin="0,8,0,8" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
     <Button x:Name="UpdateButton" Content="Update available" Visibility="Collapsed" Background="#F5F5F5" Foreground="#101010" FontSize="11" Height="26" Padding="10,0" Margin="0,0,12,0" MaxWidth="190" ToolTip="Open the new release on GitHub" Click="OpenUpdate" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
     <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Minimize to tray" Click="MinimizeClick"/>
     <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" ToolTip="Maximize / restore" Click="MaximizeClick"/>
     <Button Style="{StaticResource CaptionButton}" Content="&#xE8BB;" ToolTip="Close to tray" Click="CloseClick"/>
    </StackPanel>
   </Grid>
   <Button x:Name="PlaylistBack" Grid.Row="1" Content="← Back" Click="BackToLibrary" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="22,0,0,6" Background="Transparent" Padding="8,7"/>
   <Grid x:Name="SearchHeader" Grid.Row="1" Margin="22,6,130,12" MaxWidth="530">
    <Border Background="#E2101010" CornerRadius="8" BorderBrush="#363636" BorderThickness="1"/>
    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="#A2A2A2" Margin="15,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
    <TextBox x:Name="SearchBox" Margin="39,1,8,1" MaxLength="200" Background="Transparent" BorderThickness="0" Padding="0,7" ToolTip="Search SoundCloud tracks" AutomationProperties.Name="Search SoundCloud" TextChanged="SearchChanged" KeyDown="SearchKey"/>
    <TextBlock Text="Search SoundCloud tracks" Foreground="#929292" IsHitTestVisible="False" Margin="39,0,10,0" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
   </Grid>
   <StackPanel x:Name="SoundCloudServiceSwitch" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,22,6"><TextBlock Text="SC" FontSize="11" VerticalAlignment="Center" Margin="0,0,7,0"/><ToggleButton x:Name="HeaderModeSwitch" Style="{StaticResource CompactServiceSwitch}" Checked="BrowserModeChanged" Unchecked="BrowserModeChanged" ToolTip="Switch between SoundCloud and YouTube Music" AutomationProperties.Name="Switch music service"/><TextBlock Text="YT" FontSize="11" VerticalAlignment="Center" Margin="7,0,0,0"/></StackPanel>
   <Grid Grid.Row="2" x:Name="HomePanel" IsHitTestVisible="False"/>
   <Grid x:Name="LibraryPanel" Grid.Row="2" Visibility="Collapsed" Margin="24,0,24,16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="SoundCloud Library" FontSize="27" FontWeight="Bold"/><TextBlock x:Name="LibraryImportStatus" Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></Grid>
    <Grid Grid.Row="1" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Border Background="#DDDDDD" CornerRadius="14" Padding="16,6" VerticalAlignment="Center"><TextBlock Text="Playlists" Foreground="#111111"/></Border>
     <DockPanel Grid.Column="1" Margin="8,0,8,0" HorizontalAlignment="Right"><Button x:Name="PlaylistSortButton" Style="{StaticResource IconButton}" Margin="0,0,4,0" Click="TogglePlaylistSort"/><Button x:Name="LibraryViewToggle" Style="{StaticResource IconButton}" Margin="0,0,8,0" Click="ToggleLibraryView"/><Grid MaxWidth="260" MinWidth="120"><Border Background="#E2101010" CornerRadius="8" BorderBrush="#363636" BorderThickness="1"/><TextBox x:Name="LibraryFilter" Background="Transparent" BorderThickness="0" Margin="1" ToolTip="Search playlists" AutomationProperties.Name="Search playlists" TextChanged="FilterPlaylists"/><TextBlock Text="Search playlists" FontSize="11" Margin="10,0" Foreground="#888888" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=LibraryFilter}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DockPanel>
     <Button Grid.Column="2" Width="40" Height="36" Padding="0" VerticalAlignment="Center" ToolTip="Create playlist" AutomationProperties.Name="Create playlist" Click="CreatePlaylist"><Path Data="M 0,6 L 12,6 M 6,0 L 6,12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform"/></Button>
    </Grid>
    <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><Grid x:Name="PlaylistTableHeading" Visibility="Collapsed" Margin="16,0,16,8"><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition/><ColumnDefinition Width="65"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBlock Grid.Column="1" Text="Name" Margin="8,0" Foreground="#999999"/><TextBlock Grid.Column="2" Text="Tracks" Foreground="#999999"/><TextBlock Grid.Column="3" Text="Status" Foreground="#999999"/></Grid>
    <ListBox x:Name="PlaylistCards" Grid.Row="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="Transparent" ScrollViewer.CanContentScroll="False" PreviewMouseUp="OpenPlaylistCard" KeyDown="PlaylistCardKey">
    </ListBox></Grid>
    <TextBlock x:Name="LibraryEmpty" Grid.Row="2" Text="No playlists yet. Click + or import a public playlist." TextWrapping="Wrap" Foreground="#AAAAAA" Margin="4,20" IsHitTestVisible="False"/>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="LibraryPrevious" Width="40" Height="36" Padding="0" AutomationProperties.Name="Previous playlist page" Click="PreviousLibraryCards"><Path Data="M 7,0 L 1,6 L 7,12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="8" Height="12" Stretch="Uniform"/></Button><TextBlock x:Name="LibraryPageLabel" VerticalAlignment="Center" Margin="8,0"/><Button x:Name="LibraryNext" Width="40" Height="36" Padding="0" AutomationProperties.Name="Next playlist page" Click="NextLibraryCards"><Path Data="M 1,0 L 7,6 L 1,12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="8" Height="12" Stretch="Uniform"/></Button></StackPanel>
   </Grid>
   <Grid x:Name="YouTubeNativePanel" Grid.Row="1" Grid.RowSpan="3" Panel.ZIndex="11" Visibility="Collapsed" Margin="20,0,20,8">
    <Grid.Resources><DataTemplate x:Key="YouTubeCardTemplate">
           <Button Click="OpenYouTubeCard" Tag="{Binding}" Width="190" Padding="0" Margin="0,0,20,8" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" ToolTip="{Binding Title}">
            <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="3"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#282828"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="#383838"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
            <StackPanel><Border Background="#252525" CornerRadius="8" ClipToBounds="True"><ui:Artwork Url="{Binding Artwork}" DecodeWidth="224" Width="184" Height="184"/></Border><TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40" Margin="0,10,0,4"/><TextBlock Text="{Binding Subtitle}" Foreground="#AAAAAA" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34"/></StackPanel>
           </Button>

</DataTemplate></Grid.Resources>
    <Grid.Background><ImageBrush ImageSource="Assets/wallpaper.jpg" Stretch="UniformToFill"/></Grid.Background>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Grid.RowSpan="4" Background="#C0080808" IsHitTestVisible="False"/>
    <Grid x:Name="YouTubeSearchRow" Margin="0,0,0,2" Height="38" SizeChanged="YouTubeHeaderSizeChanged"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="YouTubeBackButton" Content="← Back" Click="YouTubeCollectionBack" HorizontalAlignment="Left" Margin="0,0,14,0" VerticalAlignment="Center"/><Grid Grid.Column="1" MaxWidth="680" Margin="0,0,10,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="#E2101010" Height="36" VerticalAlignment="Center" CornerRadius="8" BorderBrush="#363636" BorderThickness="1"><Grid><TextBox x:Name="YouTubeSearch" MaxLength="200" Background="Transparent" BorderThickness="0" Margin="4" Padding="8,3" ToolTip="Search YouTube Music · press Enter" AutomationProperties.Name="Search YouTube Music" KeyDown="SearchYouTubeNative"/><TextBlock Text="Search YouTube Music" Margin="18,0" Foreground="#929292" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=YouTubeSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Border><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0"><TextBlock Text="SC" FontSize="11" VerticalAlignment="Center" Margin="0,0,7,0"/><ToggleButton x:Name="YouTubeModeSwitch" Style="{StaticResource CompactServiceSwitch}" Checked="BrowserModeChanged" Unchecked="BrowserModeChanged" ToolTip="Switch between SoundCloud and YouTube Music" AutomationProperties.Name="Switch music service"/><TextBlock Text="YT" FontSize="11" VerticalAlignment="Center" Margin="7,0,0,0"/></StackPanel></Grid><Button x:Name="YouTubeAccountButton" Grid.Column="2" Content="Sign in / account" Click="SignInYouTubeAccount" Margin="12,0,0,0"/></Grid>
    <StackPanel Grid.Row="1"><DockPanel LastChildFill="True"><Button x:Name="YouTubeClearQueue" Content="Clear queue" Click="ClearYouTubeQueue" DockPanel.Dock="Right" HorizontalAlignment="Right" Visibility="Collapsed"/><TextBlock x:Name="YouTubeHeading" Visibility="Collapsed" Text="YouTube Music" FontSize="25" FontWeight="Bold"/></DockPanel><TextBlock x:Name="YouTubeStatus" Visibility="Collapsed" Text="Loading…" Foreground="#AAAAAA" Margin="0,6,0,12" TextWrapping="Wrap"/></StackPanel>
    <Border Grid.Row="2" Background="#D9080808" CornerRadius="10" Padding="10" Margin="0,0,0,10"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <ScrollViewer x:Name="YouTubeCardsScroll" PreviewMouseWheel="ScrollYouTubePage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
      <StackPanel>
       <Border x:Name="YouTubeCollectionHeader" Visibility="Collapsed" Background="#C0101010" CornerRadius="10" Padding="16" Margin="8,4,8,20">
        <WrapPanel><ui:Artwork x:Name="YouTubeCollectionArtwork" DecodeWidth="256" Width="220" Height="220" Margin="0,0,24,8"/><StackPanel Width="240" VerticalAlignment="Center"><TextBlock x:Name="YouTubeCollectionTitle" FontSize="27" FontWeight="Bold" TextWrapping="Wrap" Margin="0,12,0,8"/><TextBlock x:Name="YouTubeCollectionSubtitle" Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,0,0,16"/><Button Content="▶ Play all" Click="PlayYouTubeCollection" HorizontalAlignment="Left" Background="#EEEEEE" Foreground="#111111"/></StackPanel></WrapPanel>
       </Border>
       <ItemsControl x:Name="YouTubeCards" ItemTemplate="{DynamicResource YouTubeCardTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
      </StackPanel>
     </ScrollViewer>
     <ScrollViewer x:Name="YouTubeShelvesScroll" PreviewMouseWheel="ScrollYouTubePage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
      <ItemsControl x:Name="YouTubeShelves"><ItemsControl.ItemTemplate><DataTemplate>
       <StackPanel Margin="10,2,10,24">
        <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="Bold" Margin="0,0,0,16" TextWrapping="Wrap"/>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly">
         <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{DynamicResource YouTubeCardTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
         </ItemsControl>
        </ScrollViewer>
       </StackPanel>
