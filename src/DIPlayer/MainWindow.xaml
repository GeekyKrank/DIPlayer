<Window x:Class="DIPlayer.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="clr-namespace:DIPlayer.UI" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="DIPlayer" Background="#080808" Foreground="#F4F4F4" FontFamily="Segoe UI" FontSize="13"
 Width="1200" Height="780" MinWidth="440" MinHeight="560" WindowStyle="None" ResizeMode="CanResize"
 Closing="WindowClosing" StateChanged="VisibilityChanged" IsVisibleChanged="VisiblePropertyChanged"
 SourceInitialized="SourceReady" SizeChanged="LayoutChanged">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="10" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <Style x:Key="RailButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Width" Value="46"/><Setter Property="Height" Value="44"/><Setter Property="Padding" Value="0"/>
   <Setter Property="Margin" Value="0,3"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#8A8A8A"/>
   <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="20"/>
   <Style.Triggers><Trigger Property="Tag" Value="active"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#181818"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="Transparent"/><Setter Property="Width" Value="34"/><Setter Property="Height" Value="32"/>
   <Setter Property="Padding" Value="0"/><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="15"/>
  </Style>
  <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
   <Setter Property="Width" Value="36"/><Setter Property="Height" Value="30"/><Setter Property="Margin" Value="0"/>
   <Setter Property="FontSize" Value="10"/><Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
  </Style>
  <Style x:Key="ThinSlider" TargetType="Slider">
   <Setter Property="MinHeight" Value="20"/><Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
    <Grid Background="Transparent" Margin="0,6">
     <Border Background="#454545" Height="2" VerticalAlignment="Center"/>
     <Track x:Name="PART_Track">
      <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="#DADADA" Height="2" VerticalAlignment="Center"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
      <Track.Thumb><Thumb Width="8" Height="8"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="White"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
      <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
     </Track>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Border BorderBrush="#202020" BorderThickness="1"><Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Grid Grid.Column="1">
   <Border IsHitTestVisible="False"><Border.Background><ImageBrush Stretch="UniformToFill" AlignmentX="Right"><ImageBrush.ImageSource><BitmapImage UriSource="Assets/wallpaper.jpg" DecodePixelWidth="736" CacheOption="OnLoad"/></ImageBrush.ImageSource></ImageBrush></Border.Background></Border>
   <Border Background="#64000000" IsHitTestVisible="False"/>
   <Border IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#90000000" Offset="0"/><GradientStop Color="#08000000" Offset="0.8"/></LinearGradientBrush></Border.Background></Border>
   <Border IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0.55"/><GradientStop Color="#FF000000" Offset="0.88"/></LinearGradientBrush></Border.Background></Border>
  </Grid>
  <!-- Static background; no blur, animation or transparent top-level window. -->
  <Border Background="#080808" BorderBrush="#141414" BorderThickness="0,0,1,0"><DockPanel Margin="8,10">
   <Button DockPanel.Dock="Bottom" Style="{StaticResource RailButton}" Content="&#xE713;" ToolTip="Настройки подключения" AutomationProperties.Name="Настройки" Click="SettingsClick"/>
   <StackPanel>
    <Button Background="Transparent" Width="46" Height="48" Padding="8" Margin="0,0,0,17" ToolTip="DIPlayer · Главная" Click="HomeView"><Path Data="M 2,5 L 15,5 23,13 23,27 15,19 2,19 Z M 8,0 L 8,25 M 2,5 L 15,19 M 15,5 L 2,19" Stroke="#F7F7F7" StrokeThickness="1.8" Stretch="Uniform"/></Button>
    <Button x:Name="HomeNav" Tag="active" Style="{StaticResource RailButton}" Content="&#xE80F;" ToolTip="Главная" AutomationProperties.Name="Главная" Click="HomeView"/>
    <Button x:Name="SearchNav" Style="{StaticResource RailButton}" Content="&#xE721;" ToolTip="Поиск" AutomationProperties.Name="Поиск" Click="SearchView"/>
    <Button x:Name="LibraryNav" Style="{StaticResource RailButton}" Content="&#xE8F1;" ToolTip="Локальные плейлисты" AutomationProperties.Name="Плейлисты" Click="LibraryView"/>
    <Button x:Name="QueueNav" Style="{StaticResource RailButton}" Content="&#xE142;" ToolTip="Очередь" AutomationProperties.Name="Очередь" Click="QueueView"/>
    <Button Style="{StaticResource RailButton}" Content="&#xE896;" ToolTip="Импорт публичного плейлиста по ссылке" AutomationProperties.Name="Импорт по ссылке" Click="ImportClick"/>
   </StackPanel>
  </DockPanel></Border>
  <Grid Grid.Column="1">
   <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition x:Name="PlayerRow" Height="100"/></Grid.RowDefinitions>
   <Grid Margin="15,0,6,0">
    <TextBlock Text="DIPlayer" FontSize="11" Foreground="#929292" VerticalAlignment="Center" IsHitTestVisible="False"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
     <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Свернуть в трей" Click="MinimizeClick"/>
     <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" ToolTip="Развернуть / восстановить" Click="MaximizeClick"/>
     <Button Style="{StaticResource CaptionButton}" Content="&#xE8BB;" ToolTip="Закрыть в трей" Click="CloseClick"/>
    </StackPanel>
   </Grid>
   <Grid Grid.Row="1" Margin="22,6,22,12" MaxWidth="530">
    <Border Background="#E2101010" CornerRadius="8" BorderBrush="#363636" BorderThickness="1"/>
    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="#A2A2A2" Margin="15,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
    <TextBox x:Name="SearchBox" Margin="39,1,8,1" MaxLength="200" Background="Transparent" BorderThickness="0" Padding="0,7" ToolTip="Поиск треков SoundCloud" AutomationProperties.Name="Поиск SoundCloud" TextChanged="SearchChanged" KeyDown="SearchKey"/>
    <TextBlock Text="Поиск треков SoundCloud" Foreground="#929292" IsHitTestVisible="False" Margin="39,0,10,0" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
   </Grid>
   <Grid Grid.Row="2" x:Name="HomePanel" IsHitTestVisible="False" Margin="30,0,30,28"><StackPanel VerticalAlignment="Bottom"><TextBlock Text="DIPlayer" FontWeight="Light" FontSize="36" Foreground="#EEEEEE"/><TextBlock Text="Твоя музыка. В своём ритме." Foreground="#9F9F9F" FontSize="13" Margin="2,7,0,0"/></StackPanel></Grid>
   <Border x:Name="ContentPanel" Grid.Row="2" Visibility="Collapsed" Background="#D9080808" CornerRadius="10" Margin="20,6,20,16" Padding="16"><Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock x:Name="Heading" Text="Результаты поиска" FontSize="23" FontWeight="SemiBold" Margin="3,0,0,12" TextTrimming="CharacterEllipsis"/>
    <StackPanel Grid.Row="1">
     <WrapPanel x:Name="LibraryBar" Visibility="Collapsed" Margin="0,0,0,6"><ComboBox x:Name="PlaylistPicker" Width="155" Margin="3" SelectionChanged="PlaylistSelected"/><Button Content="Создать" Click="CreatePlaylist"/><Button Content="Имя" Click="RenamePlaylist"/><Button Content="Удалить" Click="DeletePlaylist"/></WrapPanel>
     <WrapPanel><Button Content="▶ Играть" Click="PlaySelected"/><Button Content="+ В очередь" Click="EnqueueSelected"/><Button Content="+ В плейлист" Click="AddToPlaylist"/><Button x:Name="RemoveButton" Content="Убрать" Click="RemoveSelected" Visibility="Collapsed"/><Button x:Name="UpButton" Content="↑" Click="MoveUp" Visibility="Collapsed"/><Button x:Name="DownButton" Content="↓" Click="MoveDown" Visibility="Collapsed"/></WrapPanel>
    </StackPanel>
    <ListBox Grid.Row="2" x:Name="Tracks" Background="Transparent" MouseDoubleClick="PlaySelected" Margin="0,10,0,6"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock Grid.Column="2" Text="{Binding Track.Duration}" Foreground="#999999" Margin="8,0,0,0" VerticalAlignment="Center"/>
     <Border Grid.Column="0" Background="#222222" Margin="0"><ui:Artwork Url="{Binding Track.Artwork}"/></Border>
     <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding Track.Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Track.Artist}" Foreground="#999999" FontSize="12" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Track.Availability}" Foreground="{StaticResource Accent}" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel>
    </Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
    <DockPanel Grid.Row="3"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="PrevPage" Content="‹" Click="PreviousPage"/><TextBlock x:Name="PageLabel" VerticalAlignment="Center" Text="1" Margin="6,0"/><Button x:Name="NextPage" Content="›" Click="FollowingPage"/></StackPanel><TextBlock x:Name="Status" Foreground="#999999" TextWrapping="Wrap" VerticalAlignment="Center" Margin="4" FontSize="11" Text="Публичные треки SoundCloud"/><Button x:Name="CancelImport" Content="Отменить импорт" Visibility="Collapsed" Click="CancelImportClick"/></DockPanel>
   </Grid></Border>
   <Border Grid.Row="3" Background="#F2080808" BorderBrush="#282828" BorderThickness="0,1,0,0"><Grid Margin="16,0,16,8">
    <Grid.RowDefinitions><RowDefinition Height="21"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><Slider x:Name="PositionSlider" Style="{StaticResource ThinSlider}" Minimum="0" Maximum="1" PreviewMouseLeftButtonUp="SeekReleased" PreviewMouseLeftButtonDown="SeekStarted" IsMoveToPointEnabled="True" AutomationProperties.Name="Позиция трека"/><TextBlock Grid.Column="1" x:Name="TimeLabel" Text="0:00 / 0:00" FontSize="10" Foreground="#999999" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
    <Grid Grid.Row="1" x:Name="PlayerLayout">
     <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition x:Name="CompactControlsRow" Height="0"/></Grid.RowDefinitions>
     <Grid.ColumnDefinitions><ColumnDefinition x:Name="TrackColumn" Width="*"/><ColumnDefinition x:Name="ControlsColumn" Width="160"/><ColumnDefinition x:Name="ExtrasColumn" Width="*"/></Grid.ColumnDefinitions>
     <Grid x:Name="TrackInfo" Margin="0,0,10,0" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Width="40" Height="40" Background="#202020" HorizontalAlignment="Left"><Grid><TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" Foreground="#888888" HorizontalAlignment="Center" VerticalAlignment="Center"/><ui:Artwork x:Name="NowArtwork" Width="40" Height="40"/></Grid></Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="NowTitle" Text="DIPlayer" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="NowArtist" Text="Выберите трек" Foreground="#929292" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel>
     </Grid>
     <StackPanel x:Name="Transport" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Button Style="{StaticResource IconButton}" Content="&#xE892;" Click="PreviousTrack" ToolTip="Предыдущий"/>
      <Button x:Name="PlayPause" Content="&#xE768;" Width="38" Height="38" Margin="6,0" Background="#F5F5F5" Foreground="#080808" Click="ToggleClick" ToolTip="Воспроизведение / пауза" AutomationProperties.Name="Воспроизведение / пауза"><Button.Template><ControlTemplate TargetType="Button"><Grid><Ellipse Fill="{TemplateBinding Background}"/><TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template></Button>
      <Button Style="{StaticResource IconButton}" Content="&#xE893;" Click="NextTrack" ToolTip="Следующий"/>
     </StackPanel>
     <StackPanel x:Name="PlayerExtras" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
      <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Click="RetryTrack" ToolTip="Повторить подключение"/>
      <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" Foreground="#B7B7B7" VerticalAlignment="Center" Margin="5,0"/>
      <Slider x:Name="VolumeSlider" Style="{StaticResource ThinSlider}" Width="66" Minimum="0" Maximum="1" Value="0.6" ValueChanged="VolumeChanged" AutomationProperties.Name="Громкость"/>
      <Button Style="{StaticResource IconButton}" Content="&#xE142;" Click="QueueView" ToolTip="Очередь"/>
      <Button x:Name="SourceButton" Background="Transparent" Padding="4" Margin="5,0,0,0" Click="OpenSource" ToolTip="Открыть SoundCloud"><Image Source="Assets/soundcloud-white.png" Width="28" Stretch="Uniform"/></Button>
     </StackPanel>
    </Grid>
   </Grid></Border>
  </Grid>
 </Grid></Border>
</Window>
