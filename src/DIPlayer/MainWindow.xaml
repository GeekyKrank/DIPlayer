          <Border x:Name="CoverShade" Background="Black" Opacity="0" IsHitTestVisible="False" />
          <Grid x:Name="CoverCue" Width="38" Height="38" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12" Opacity="0" IsHitTestVisible="False">
           <Ellipse Fill="#F4F4F4" /><TextBlock x:Name="CoverCueIcon" Text="{x:Static ui:Symbols.Play}" FontFamily="{x:Static ui:Symbols.Font}" Foreground="#111111" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Normal" />
          </Grid>
         </Grid>
         <TextBlock Text="{Binding Title}" Foreground="{TemplateBinding Foreground}" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40" Margin="0,11,0,4" />
         <TextBlock Text="{Binding Subtitle}" Foreground="#B6B6B6" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" Margin="0,0,0,4" />
        </StackPanel>
       </Border>
       <ControlTemplate.Triggers>
        <DataTrigger Binding="{Binding IsVideo}" Value="True"><Setter TargetName="CoverFrame" Property="Height" Value="182" /></DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Artist"><Setter TargetName="CoverFrame" Property="ui:RoundedClip.Radius" Value="92" /><Setter TargetName="CoverCueIcon" Property="Text" Value="{x:Static ui:Symbols.User}" /></DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Album"><Setter TargetName="CoverCueIcon" Property="Text" Value="{x:Static ui:Symbols.Album}" /></DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Playlist"><Setter TargetName="CoverCueIcon" Property="Text" Value="{x:Static ui:Symbols.Queue}" /></DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Browse"><Setter TargetName="CoverCueIcon" Property="Text" Value="{x:Static ui:Symbols.Forward}" /></DataTrigger>
        <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True" /><Condition Property="ui:Motion.Enabled" Value="True" /></MultiTrigger.Conditions>
         <MultiTrigger.EnterActions><BeginStoryboard><Storyboard>
          <DoubleAnimation Storyboard.TargetName="CoverShade" Storyboard.TargetProperty="Opacity" To="0.28" Duration="0:0:0.18" />
          <DoubleAnimation Storyboard.TargetName="CoverCue" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
         </Storyboard></BeginStoryboard></MultiTrigger.EnterActions>
         <MultiTrigger.ExitActions><BeginStoryboard><Storyboard>
          <DoubleAnimation Storyboard.TargetName="CoverShade" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" FillBehavior="Stop" />
          <DoubleAnimation Storyboard.TargetName="CoverCue" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" FillBehavior="Stop" />
         </Storyboard></BeginStoryboard></MultiTrigger.ExitActions>
        </MultiTrigger><MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True" /><Condition Property="ui:Motion.Enabled" Value="False" /></MultiTrigger.Conditions><Setter TargetName="CoverShade" Property="Opacity" Value="0.28" /><Setter TargetName="CoverCue" Property="Opacity" Value="1" /></MultiTrigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CardFrame" Property="BorderBrush" Value="#BBBBBB" /><Setter TargetName="CoverShade" Property="Opacity" Value="0.2" /><Setter TargetName="CoverCue" Property="Opacity" Value="1" /></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="CardFrame" Property="Opacity" Value="0.8" /></Trigger>
       </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><DataTrigger Binding="{Binding IsVideo}" Value="True"><Setter Property="Width" Value="332" /></DataTrigger></Style.Triggers>
     </Style>
