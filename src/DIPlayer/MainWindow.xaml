     <TextBlock Text="Settings" FontSize="27" FontWeight="Bold" Margin="0,0,0,24"/>
     <TextBlock Text="Player mode" FontSize="20" FontWeight="Bold"/>
     <TextBlock Text="Switch between the optimized SoundCloud player and a YouTube Music browser inside DIPlayer." TextWrapping="Wrap" Foreground="#AAAAAA" Margin="0,10,0,20"/>
     <WrapPanel VerticalAlignment="Center">
      <TextBlock Text="SoundCloud" VerticalAlignment="Center" Margin="0,0,12,0"/>
      <ToggleButton x:Name="BrowserModeSwitch" Width="52" Height="28" Margin="0,0,12,0" Cursor="Hand" Checked="BrowserModeChanged" Unchecked="BrowserModeChanged" AutomationProperties.Name="Use YouTube Music browser">
       <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Grid><Border x:Name="SwitchTrack" Background="#444444" CornerRadius="14"/><Ellipse x:Name="SwitchThumb" Fill="White" Width="22" Height="22" HorizontalAlignment="Left" Margin="3"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="SwitchTrack" Property="Background" Value="#A43A3A"/><Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SwitchTrack" Property="BorderBrush" Value="White"/><Setter TargetName="SwitchTrack" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
      </ToggleButton>
      <TextBlock Text="YouTube Music" VerticalAlignment="Center"/>
     </WrapPanel>
     <TextBlock x:Name="SettingsModeMessage" Text="Optimized SoundCloud mode. The embedded browser is unloaded." TextWrapping="Wrap" Foreground="#BEBEBE" Margin="0,18,0,12"/>
     <TextBlock Text="Browser mode uses Microsoft Edge WebView2 behind the DIPlayer interface. Search and playback controls are available here; Website / sign in opens the original page. uBO Lite ad blocking is experimental and cannot guarantee ad-free playback or access to every track. Availability, region and account restrictions still apply." TextWrapping="Wrap" Foreground="#888888" Margin="0,0,0,16"/>
     <TextBlock Text="Switching to SoundCloud closes the browser and stops its audio. The mini player and media keys control the currently selected service. Browser sign-in, if supported by Google, stays in a separate local browser profile." TextWrapping="Wrap" Foreground="#888888" Margin="0,0,0,16"/>
     <WrapPanel><Button Content="Done" Click="ClosePlayerSettings"/><Button Content="WebView2 Runtime" Click="OpenWebViewRuntime"/></WrapPanel>
    </StackPanel></ScrollViewer>
   </Border>
   <Border x:Name="ContentPanel" Grid.Row="2" Visibility="Collapsed" Background="#D9080808" CornerRadius="10" Margin="20,6,20,16" Padding="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition x:Name="PlaylistSummaryColumn" Width="0"/><ColumnDefinition/></Grid.ColumnDefinitions><ScrollViewer x:Name="PlaylistSummary" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,24,0"><StackPanel><ContentControl x:Name="DetailCover" ContentTemplate="{StaticResource PlaylistCover}" Height="230"/><TextBlock x:Name="DetailName" FontSize="24" FontWeight="Bold" TextWrapping="Wrap" Margin="0,18,0,8"/><TextBlock x:Name="DetailCount" Foreground="#AAAAAA" Margin="0,0,0,18"/><Button Content="▶  Play all" Background="#DDDDDD" Foreground="#111111" Click="PlayWholePlaylist"/><Button Content="+ Queue all" Click="EnqueueWholePlaylist"/><StackPanel x:Name="SummaryPlaylistActions" Margin="0,10,0,0"><WrapPanel x:Name="LibraryBar" Visibility="Collapsed" Margin="0,0,0,6"><ComboBox x:Name="PlaylistPicker" Visibility="Collapsed" SelectionChanged="PlaylistSelected"/><Button x:Name="RenamePlaylistButton" Content="Edit" Click="RenamePlaylist"/><Button x:Name="DeletePlaylistButton" Content="Delete" Click="DeletePlaylist"/><Button x:Name="CompactPlayAll" Content="▶ All" Click="PlayWholePlaylist" Visibility="Collapsed"/></WrapPanel></StackPanel></StackPanel></ScrollViewer><Grid x:Name="TrackContent" Grid.Column="1">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
