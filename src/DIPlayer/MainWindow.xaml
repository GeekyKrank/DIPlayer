<Window x:Class="DIPlayer.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:DIPlayer.UI" Title="DIPlayer" Background="#14161A" Foreground="#E7E8EB" FontFamily="Segoe UI" FontSize="14" Width="940" Height="710" MinWidth="440" MinHeight="560" Closing="WindowClosing" StateChanged="VisibilityChanged" IsVisibleChanged="VisiblePropertyChanged" SourceInitialized="SourceReady">
 <Grid Margin="18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="DI" Foreground="{StaticResource Accent}" FontSize="25" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/><Grid Grid.Column="1" MaxWidth="560"><TextBox x:Name="SearchBox" MaxLength="200" HorizontalAlignment="Stretch" ToolTip="Поиск треков SoundCloud" AutomationProperties.Name="Поиск SoundCloud" TextChanged="SearchChanged" KeyDown="SearchKey"/><TextBlock Text="Поиск треков SoundCloud" Foreground="#9298A3" IsHitTestVisible="False" Margin="11,0" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><Button Grid.Column="2" Content="⚙" ToolTip="Настройки подключения" Click="SettingsClick"/></Grid>
  <WrapPanel Grid.Row="1" Margin="0,12,0,8"><Button Content="Поиск" Click="SearchView"/><Button Content="Очередь" Click="QueueView"/><Button Content="Плейлисты" Click="LibraryView"/><Button Content="Импорт по ссылке" Click="ImportClick"/></WrapPanel>
  <StackPanel Grid.Row="2">
   <TextBlock x:Name="Heading" Text="Музыка начинается с поиска" FontSize="23" FontWeight="SemiBold" Margin="3,0,0,8"/>
   <WrapPanel x:Name="LibraryBar" Visibility="Collapsed"><ComboBox x:Name="PlaylistPicker" Width="170" Margin="3" SelectionChanged="PlaylistSelected"/><Button Content="Создать" Click="CreatePlaylist"/><Button Content="Имя" Click="RenamePlaylist"/><Button Content="Удалить" Click="DeletePlaylist"/></WrapPanel>
   <WrapPanel><Button Content="▶ Играть" Click="PlaySelected"/><Button Content="+ В очередь" Click="EnqueueSelected"/><Button Content="+ В плейлист" Click="AddToPlaylist"/><Button x:Name="RemoveButton" Content="Убрать" Click="RemoveSelected" Visibility="Collapsed"/><Button x:Name="UpButton" Content="↑" Click="MoveUp" Visibility="Collapsed"/><Button x:Name="DownButton" Content="↓" Click="MoveDown" Visibility="Collapsed"/></WrapPanel>
  </StackPanel>
  <ListBox Grid.Row="3" x:Name="Tracks" MouseDoubleClick="PlaySelected" Margin="0,8"><ListBox.ItemTemplate><DataTemplate><DockPanel LastChildFill="True"><TextBlock DockPanel.Dock="Right" Text="{Binding Track.Duration}" Foreground="#AFB3BC" Margin="8,0,0,0" VerticalAlignment="Center"/><Border DockPanel.Dock="Left" Background="#2B2E35" CornerRadius="4" Margin="0,0,12,0"><ui:Artwork Url="{Binding Track.Artwork}"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Track.Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Track.Artist}" Foreground="#AFB3BC" FontSize="12" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Track.Availability}" Foreground="{StaticResource Accent}" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
  <DockPanel Grid.Row="4"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="PrevPage" Content="‹" Click="PreviousPage"/><TextBlock x:Name="PageLabel" VerticalAlignment="Center" Text="1" Margin="6,0"/><Button x:Name="NextPage" Content="›" Click="FollowingPage"/></StackPanel><TextBlock x:Name="Status" Foreground="#AFB3BC" TextWrapping="Wrap" VerticalAlignment="Center" Margin="4" Text="Публичные треки SoundCloud • локальная библиотека"/><Button x:Name="CancelImport" Content="Отменить импорт" Visibility="Collapsed" Click="CancelImportClick"/></DockPanel>
  <Border Grid.Row="5" Background="#23262C" CornerRadius="8" Margin="0,12,0,0" Padding="12"><StackPanel>
   <DockPanel><Button DockPanel.Dock="Right" Content="↗" ToolTip="Открыть текущий трек на SoundCloud" Click="OpenSoundCloud"/><StackPanel><TextBlock x:Name="NowTitle" Text="DIPlayer" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="NowArtist" Text="Выберите трек" Foreground="#AFB3BC" FontSize="12" TextTrimming="CharacterEllipsis"/></StackPanel></DockPanel>
   <Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="85"/></Grid.ColumnDefinitions><Slider x:Name="PositionSlider" Minimum="0" Maximum="1" PreviewMouseLeftButtonUp="SeekReleased" PreviewMouseLeftButtonDown="SeekStarted" IsMoveToPointEnabled="True" AutomationProperties.Name="Позиция трека"/><TextBlock Grid.Column="1" x:Name="TimeLabel" Text="0:00 / 0:00" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
   <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Звук" Foreground="#AFB3BC" FontSize="12" VerticalAlignment="Center"/><Slider x:Name="VolumeSlider" Width="85" Minimum="0" Maximum="1" Value="0.6" ValueChanged="VolumeChanged" AutomationProperties.Name="Громкость"/></StackPanel><WrapPanel><Button Content="⏮" Click="PreviousTrack" ToolTip="Предыдущий"/><Button x:Name="PlayPause" Content="▶ / Ⅱ" Background="#A44E24" Click="ToggleClick" ToolTip="Воспроизведение / пауза"/><Button Content="⏭" Click="NextTrack" ToolTip="Следующий"/><Button Content="Повторить" Click="RetryTrack"/></WrapPanel></DockPanel>
  </StackPanel></Border>
  <DockPanel Grid.Row="6" Margin="3,8,3,0"><Button Background="#121212" Padding="5,2" Margin="0" Click="OpenSource" ToolTip="Источник музыки — SoundCloud"><StackPanel Orientation="Horizontal"><Image Source="Assets/soundcloud-white.png" Width="36" Stretch="Uniform"/><TextBlock Text="SoundCloud" Foreground="#FAFAFA" FontSize="11" VerticalAlignment="Center" Margin="7,0,0,0"/></StackPanel></Button><TextBlock DockPanel.Dock="Right" Text="Закрытие окна → трей" Foreground="#959AA5" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
 </Grid>
</Window>
