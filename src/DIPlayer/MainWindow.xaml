       <Border x:Name="CardFrame" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="10" Padding="3">
        <StackPanel>
         <Grid x:Name="CoverFrame" Height="184" Background="#252525" ui:RoundedClip.Radius="8">
